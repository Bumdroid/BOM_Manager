<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Design_Automation_Portal</AssemblyName>
    <RootNamespace>BOMManager</RootNamespace>
    <StartupObject>BOMManager.App</StartupObject>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Design Automation Portal</Product>
    <Company>CAD Automation</Company>
    <ApplicationIcon>resources\app.ico</ApplicationIcon>
    <Description>Design Automation Portal (.NET C# Standalone)</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>lib\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>lib\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>lib\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework">
      <HintPath>lib\Autodesk.DataManagement.Client.Framework.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.DataManagement.Client.Framework.Vault">
      <HintPath>lib\Autodesk.DataManagement.Client.Framework.Vault.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.Connectivity.WebServices">
      <HintPath>lib\Autodesk.Connectivity.WebServices.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Autodesk.Connectivity.WebServices.WCF">
      <HintPath>lib\Autodesk.Connectivity.WebServices.WCF.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Include="tests\**" />
    <Compile Remove="dist_standalone\**" />
    <None Include="dist_standalone\**" />
    <Compile Remove="Ref_temp\**" />
    <None Include="Ref_temp\**" />
    <Compile Remove="scratch\**" />
    <None Include="scratch\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\Fonts\*.ttf" />
    <None Update="resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="lib\SolidWorks.Interop.sldworks.dll;lib\SolidWorks.Interop.swconst.dll;lib\SolidWorks.Interop.swpublished.dll;lib\Autodesk.DataManagement.Client.Framework.dll;lib\Autodesk.DataManagement.Client.Framework.Vault.dll;lib\Autodesk.Connectivity.WebServices.dll;lib\Autodesk.Connectivity.WebServices.WCF.dll;lib\Autodesk.DataManagement.Client.Framework.Forms.dll;lib\Autodesk.DataManagement.Client.Framework.Vault.Forms.dll;lib\Autodesk.Connectivity.LicenseWrapper.dll;lib\AdskLicensingSDK_8.dll;lib\AdskIdentitySDK.dll;lib\adsk_hive_sdk.dll" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="lib\SolidWorks.Interop.sldworks.dll;lib\SolidWorks.Interop.swconst.dll;lib\SolidWorks.Interop.swpublished.dll;lib\Autodesk.DataManagement.Client.Framework.dll;lib\Autodesk.DataManagement.Client.Framework.Vault.dll;lib\Autodesk.Connectivity.WebServices.dll;lib\Autodesk.Connectivity.WebServices.WCF.dll;lib\Autodesk.DataManagement.Client.Framework.Forms.dll;lib\Autodesk.DataManagement.Client.Framework.Vault.Forms.dll;lib\Autodesk.Connectivity.LicenseWrapper.dll;lib\AdskLicensingSDK_8.dll;lib\AdskIdentitySDK.dll;lib\adsk_hive_sdk.dll" DestinationFolder="$(ProjectDir)" OverwriteReadOnlyFiles="true" ContinueOnError="true" />
  </Target>
</Project>
