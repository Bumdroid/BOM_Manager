<Window x:Class="BOMManager.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Auto"
        Title="Design Automation Portal"
        Width="1040" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Card Container Style (Clean Non-Clickable Card Surface) -->
        <Style x:Key="AppCardContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Color="#0F172A"
                                      Opacity="0.06"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Launch Button Style (Clickable Action Bar Only) -->
        <Style x:Key="LaunchActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style (Gray/Neutral) -->
        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Concept 3 Split Button Style for Settings -->
        <Style x:Key="Concept3SplitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header (Brand, User, Settings) -->
            <RowDefinition Height="Auto"/> <!-- 1: Welcome / Hero Section -->
            <RowDefinition Height="*"/>    <!-- 2: Smartphone App Grid -->
            <RowDefinition Height="Auto"/> <!-- 3: Footer Status -->
        </Grid.RowDefinitions>

        <!-- 0. Top Navigation and User Header Panel -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#0F172A" Opacity="0.04" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand / Logo -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- User Profile Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- Settings Button -->
                </Grid.ColumnDefinitions>

                <!-- Brand Title with Alpha V0.0 Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Design Automation Portal"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>
                    <Border Background="#F5F3FF"
                            BorderBrush="#8B5CF6"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Alpha V0.0"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#7C3AED"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- User Account Badge -->
                <Border Grid.Column="2"
                        Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="40"
                        Padding="12,0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="imgVaultIcon" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Autodesk Vault" FontSize="9" FontWeight="Medium" Foreground="#16A34A"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="사용자: " FontSize="13" FontWeight="Regular" Foreground="#15803D"/>
                                <TextBlock x:Name="txtVaultUsername" Text="이두규" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                            </StackPanel>
                        </StackPanel>
                        <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="2,0,0,0" VerticalAlignment="Center" ToolTip="Vault 연결됨"/>
                    </StackPanel>
                </Border>

                <!-- Settings Split Combo Button ([ ⚙️ | v ]) -->
                <Button x:Name="btnSettings"
                        Grid.Column="3"
                        Style="{StaticResource Concept3SplitButtonStyle}"
                        Height="40"
                        ToolTip="환경설정 및 계정 관리"
                        Click="BtnSettings_Click">
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Part: Perfectly Dead-Centered CAD Precision Outline Gear Icon -->
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Path Data="M 12 1.5 C 11.2 1.5 10.9 2.1 10.8 2.8 L 10.4 4.5 C 9.4 4.9 8.5 5.5 7.7 6.3 L 6.1 5.4 C 5.4 5 4.6 5.3 4.2 6 L 2.7 8.6 C 2.3 9.3 2.5 10.2 3.2 10.7 L 4.6 11.7 C 4.5 12.3 4.5 12.9 4.5 13.5 C 4.5 14.1 4.5 14.7 4.6 15.3 L 3.2 16.3 C 2.5 16.8 2.3 17.7 2.7 18.4 L 4.2 21 C 4.6 21.7 5.4 22 6.1 21.6 L 7.7 20.7 C 8.5 21.5 9.4 22.1 10.4 22.5 L 10.8 24.2 C 10.9 24.9 11.2 25.5 12 25.5 L 15 25.5 C 15.8 25.5 16.1 24.9 16.2 24.2 L 16.6 22.5 C 17.6 22.1 18.5 21.5 19.3 20.7 L 20.9 21.6 C 21.6 22 22.4 21.7 22.8 21 L 24.3 18.4 C 24.7 17.7 24.5 16.8 23.8 16.3 L 22.4 15.3 C 22.5 14.7 22.5 14.1 22.5 13.5 C 22.5 12.9 22.5 12.3 22.4 11.7 L 23.8 10.7 C 24.5 10.2 24.7 9.3 24.3 8.6 L 22.8 6 C 22.4 5.3 21.6 5 20.9 5.4 L 19.3 6.3 C 18.5 5.5 17.6 4.9 16.6 4.5 L 16.2 2.8 C 16.1 2.1 15.8 1.5 15 1.5 Z M 13.5 9 C 16 9 18 11 18 13.5 C 18 16 16 18 13.5 18 C 11 18 9 16 9 13.5 C 9 11 11 9 13.5 9 Z"
                                  Stroke="#243342"
                                  StrokeThickness="2.0"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Width="22" Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"/>
                            <!-- Subtle Vertical Divider -->
                            <Rectangle Width="1.5" Height="22" Fill="#CBD5E1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Right Part: Perfectly Centered Dropdown Chevron Box -->
                        <Grid Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Path Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="#243342"
                                  StrokeThickness="2.0"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="8" Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <Button.ContextMenu>
                        <ContextMenu x:Name="ctxSettingsMenu">
                            <MenuItem Header="🔑 Vault 로그인 계정 변경"
                                      FontSize="14"
                                      FontWeight="Medium"
                                      Padding="12,8"
                                      Click="MenuItemChangeLogin_Click"/>
                            <Separator/>
                            <MenuItem Header="ℹ️ 애플리케이션 정보"
                                      FontSize="14"
                                      FontWeight="Regular"
                                      Padding="12,8"
                                      Click="MenuItemAbout_Click"/>
                            <MenuItem Header="🚪 프로그램 종료"
                                      FontSize="14"
                                      FontWeight="Regular"
                                      Padding="12,8"
                                      Click="MenuItemExit_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- 1. Hero / Welcome Banner -->
        <Border Grid.Row="1"
                Background="Transparent"
                Margin="4,0,4,16">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="안녕하세요, " FontSize="22" FontWeight="Normal" Foreground="#334155"/>
                    <TextBlock x:Name="txtWelcomeUser" Text="이두규" FontSize="22" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text=" 님 👋" FontSize="22" FontWeight="Normal" Foreground="#334155"/>
                </StackPanel>
                <TextBlock Text="실행하실 자동화 앱을 선택하세요." FontSize="14" FontWeight="Regular" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 2. Smartphone App Launcher Grid (3 Major Apps) -->
        <Grid Grid.Row="2" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App 1: BOM Manager V0.0 (SolidWorks 2021) -->
            <Border Grid.Column="0" Style="{StaticResource AppCardContainerStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Icon & Badge -->
                        <RowDefinition Height="Auto"/> <!-- App Title & Engine -->
                        <RowDefinition Height="*"/>    <!-- Description -->
                        <RowDefinition Height="Auto"/> <!-- Feature Tags (Aligned) -->
                        <RowDefinition Height="Auto"/> <!-- Action Button Bar -->
                    </Grid.RowDefinitions>

                    <!-- Icon & Active Status Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <!-- Squircle App Icon (BOM Manager Blue) -->
                        <Border HorizontalAlignment="Left"
                                Width="72" Height="72"
                                CornerRadius="20"
                                BorderThickness="1.5"
                                BorderBrush="#BFDBFE">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EFF6FF" Offset="0.0"/>
                                    <GradientStop Color="#DBEAFE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#3B82F6" Opacity="0.18" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Image x:Name="imgBomAppLogo" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Status Pill Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#ECFDF5"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="실행 가능" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- App Title & Engine -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="BOM Manager" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="Alpha V0.1" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                            <TextBlock Text="SolidWorks 2021 연동" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Grid.Row="2"
                               Text="BOM 및 3D CAD 구조를 표준화 하고, 도면번호와 재질을 입력하여 후속 자동화에 사용합니다."
                               FontSize="12"
                               FontWeight="Regular"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Top"
                               Margin="0,0,0,12"/>

                    <!-- Feature Tags -->
                    <WrapPanel Grid.Row="3" MinHeight="58" Margin="0,0,0,16" VerticalAlignment="Top">
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="🌲 3D CAD 트리 표준화" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="⚡ 도면번호/재질 입력" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="🔒 타 자동화 자료 연동" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                    </WrapPanel>

                    <!-- Launch Action Button (Only button click launches app) -->
                    <Button Grid.Row="4"
                            Style="{StaticResource LaunchActionBtnStyle}"
                            Click="BtnLaunchBomManager_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="앱 실행하기" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text=" ➔" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- App 2: 제작도 V0.0 (AutoCAD 2025 Dummy) -->
            <Border Grid.Column="2" Style="{StaticResource AppCardContainerStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Icon & Badge -->
                        <RowDefinition Height="Auto"/> <!-- App Title & Engine -->
                        <RowDefinition Height="*"/>    <!-- Description -->
                        <RowDefinition Height="Auto"/> <!-- Feature Tags (Aligned) -->
                        <RowDefinition Height="Auto"/> <!-- Action Button Bar -->
                    </Grid.RowDefinitions>

                    <!-- Icon & Status Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <!-- Squircle App Icon (CAD Green) -->
                        <Border HorizontalAlignment="Left"
                                Width="72" Height="72"
                                CornerRadius="20"
                                BorderThickness="1.5"
                                BorderBrush="#A7F3D0"
                                Background="#1E293B">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#059669" Opacity="0.18" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Image x:Name="imgDwgAppLogo" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Status Pill Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="개발중" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- App Title & Engine -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="제작도" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#D1FAE5" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="개발예정" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                            </Border>
                            <TextBlock Text="AutoCAD 2025 연동" FontSize="12" FontWeight="SemiBold" Foreground="#059669" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Grid.Row="2"
                               Text="BOM Manager 입력값을 기준으로 제작도 표제, BOM, 3면도를 자동생성합니다."
                               FontSize="12"
                               FontWeight="Regular"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Top"
                               Margin="0,0,0,12"/>

                    <!-- Feature Tags -->
                    <WrapPanel Grid.Row="3" MinHeight="58" Margin="0,0,0,16" VerticalAlignment="Top">
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="📐 One click 제작도 생성" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                    </WrapPanel>

                    <!-- Launch Action Button -->
                    <Button Grid.Row="4"
                            Style="{StaticResource SecondaryActionBtnStyle}"
                            Click="BtnLaunchDrawingMaker_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="모듈 안내 확인" FontSize="14" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Text=" ➔" FontSize="14" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- App 3: 스프링 설계 V1.0 (Spring Designer) -->
            <Border Grid.Column="4" Style="{StaticResource AppCardContainerStyle}">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Icon & Badge -->
                        <RowDefinition Height="Auto"/> <!-- App Title & Engine -->
                        <RowDefinition Height="*"/>    <!-- Description -->
                        <RowDefinition Height="Auto"/> <!-- Feature Tags (Aligned) -->
                        <RowDefinition Height="Auto"/> <!-- Action Button Bar -->
                    </Grid.RowDefinitions>

                    <!-- Icon & Status Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <!-- Squircle App Icon (Indigo/Spring) -->
                        <Border HorizontalAlignment="Left"
                                Width="72" Height="72"
                                CornerRadius="20"
                                BorderThickness="1.5"
                                BorderBrush="#C7D2FE">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF2FF" Offset="0.0"/>
                                    <GradientStop Color="#E0E7FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#4F46E5" Opacity="0.18" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <Image x:Name="imgSpringAppLogo" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Status Pill Badge -->
                        <Border x:Name="borderSpringStatus"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#ECFDF5"
                                BorderBrush="#A7F3D0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="dotSpringStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSpringStatus" Text="실행 가능" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- App Title & Engine -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="스프링 설계" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="V0.2" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                            </Border>
                            <TextBlock Text="사양 계산 / 2D 도면작성" FontSize="12" FontWeight="SemiBold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Description -->
                    <TextBlock Grid.Row="2"
                               Text="미고정 설계 파라메터를 자동 최적화해 하중·허용응력·밀착고를 만족하는 스프링 사양(신규·공용)을 제안하고 2D 도면을 자동 생성합니다. (3D CAD내 자동 배치 추후 개발예정)"
                               FontSize="12"
                               FontWeight="Regular"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               VerticalAlignment="Top"
                               Margin="0,0,0,12"/>

                    <!-- Feature Tags -->
                    <WrapPanel Grid.Row="3" MinHeight="58" Margin="0,0,0,16" VerticalAlignment="Top">
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="🌀 스프링 사양 자동화(신작/공용)" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="📚 공용화 DB 200종 내장" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,6">
                            <TextBlock Text="📐 2D 도면 자동작성" FontSize="10" Foreground="#475569" FontWeight="Medium"/>
                        </Border>
                    </WrapPanel>

                    <!-- Launch Action Button (Only button click launches spring designer) -->
                    <Button x:Name="btnLaunchSpringAction"
                            Grid.Row="4"
                            Style="{StaticResource LaunchActionBtnStyle}"
                            Click="BtnLaunchSpringDesigner_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="txtSpringAction" Text="앱 실행하기" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSpringActionArrow" Text=" ➔" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Footer System Status and Copyright -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
