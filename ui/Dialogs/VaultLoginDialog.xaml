<Window x:Class="BOMManager.UI.Dialogs.VaultLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autodesk Vault 로그인"
        Width="440" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif"
        Loaded="Window_Loaded">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="imgVaultIcon"
                       Width="38" Height="38"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Autodesk Vault 로그인"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>
                    <TextBlock Text="BOM Manager 시작을 위해 사용자 계정을 입력하세요."
                               FontSize="11.5"
                               Foreground="#3B82F6"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Vault User Field (Editable, Primary Focus) -->
            <TextBlock Text="Vault User (사용자 명):"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtUsername"
                     Height="34"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Padding="8,5"
                     VerticalContentAlignment="Center"
                     BorderBrush="#2563EB"
                     BorderThickness="1.5"
                     Background="#FFFFFF"
                     Foreground="#0F172A"
                     Margin="0,0,0,12"
                     KeyDown="TxtUsername_KeyDown"/>

            <!-- Server Field (Fixed, Read-only) -->
            <TextBlock Text="Server (서버 IP):"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtServer"
                     Text="192.168.150.105"
                     IsReadOnly="True"
                     Focusable="False"
                     Height="30"
                     FontSize="12"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     BorderBrush="#E2E8F0"
                     BorderThickness="1"
                     Background="#F1F5F9"
                     Foreground="#64748B"
                     Margin="0,0,0,10"/>

            <!-- Vault Name Field (Fixed, Read-only) -->
            <TextBlock Text="Vault Name (저장소 이름):"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtVaultName"
                     Text="ISC_Vault"
                     IsReadOnly="True"
                     Focusable="False"
                     Height="30"
                     FontSize="12"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     BorderBrush="#E2E8F0"
                     BorderThickness="1"
                     Background="#F1F5F9"
                     Foreground="#64748B"
                     Margin="0,0,0,10"/>

            <!-- Password Field (Fixed Empty, Read-only) -->
            <TextBlock Text="Password (비밀번호):"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#64748B"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="txtPassword"
                     Text=""
                     IsReadOnly="True"
                     Focusable="False"
                     Height="30"
                     FontSize="12"
                     Padding="8,4"
                     VerticalContentAlignment="Center"
                     BorderBrush="#E2E8F0"
                     BorderThickness="1"
                     Background="#F1F5F9"
                     Foreground="#94A3B8"
                     Margin="0,0,0,8"/>

            <!-- Auto Login CheckBox -->
            <CheckBox x:Name="chkAutoLogin"
                      Content="자동 로그인"
                      IsChecked="True"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Foreground="#334155"
                      Margin="2,2,0,8"
                      VerticalContentAlignment="Center"
                      Cursor="Hand"/>

            <!-- Status / Progress Indicator -->
            <StackPanel x:Name="pnlProgress"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True"
                             Width="100" Height="4"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                <TextBlock Text="Vault 서버 접속 확인 중..."
                           FontSize="11"
                           Foreground="#2563EB"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btnCancel"
                    Content="종료"
                    Width="80" Height="34"
                    Margin="0,0,8,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    Foreground="#475569"
                    FontSize="12"
                    FontWeight="SemiBold"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>

            <Button x:Name="btnLogin"
                    Content="로그인"
                    Width="100" Height="34"
                    Background="#0284C7"
                    BorderBrush="#0369A1"
                    Foreground="#FFFFFF"
                    FontSize="12.5"
                    FontWeight="Bold"
                    IsDefault="True"
                    Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
