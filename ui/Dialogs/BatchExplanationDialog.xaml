<Window x:Class="BOMManager.UI.Dialogs.BatchExplanationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설명충 일괄 지정 (Batch Explanation)"
        Width="420" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblInfo"
                   Text="선택한 파트에 일괄 적용할 설명충(Explanation)을 입력하세요:"
                   TextWrapping="Wrap"
                   Foreground="#1E293B"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TextBox Grid.Row="1" x:Name="txtExplanation"
                 Height="32"
                 FontSize="13"
                 Padding="6,4"
                 VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="확인" Width="80" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="BtnOk_Click"/>
            <Button Content="취소" Width="80" Height="30"
                    IsCancel="True"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
