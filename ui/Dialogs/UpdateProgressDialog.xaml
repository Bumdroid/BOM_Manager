<Window x:Class="BOMManager.UI.Dialogs.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자동 업데이트 확인"
        Width="460" Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Primary Action Button Style -->
        <Style x:Key="ModernBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content Body -->
            <RowDefinition Height="Auto"/> <!-- Button Bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                x:Name="borderHeader"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="borderIconContainer"
                        Width="40" Height="40"
                        Background="#DBEAFE"
                        CornerRadius="10"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderIcon"
                               Text="🔄"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle"
                               Text="업데이트 확인"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#1E3A8A"/>
                    <TextBlock x:Name="txtHeaderSubtitle"
                               Text="업데이트를 확인 중입니다..."
                               FontSize="12"
                               Foreground="#2563EB"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Body -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <!-- State 1 & 2: Checking / Downloading Progress -->
            <StackPanel x:Name="panelProgress" VerticalAlignment="Center">
                <TextBlock x:Name="txtMessage"
                           Text="Autodesk Vault 서버에서 최신 자동화 모듈 배포 버전을 확인하고 있습니다."
                           FontSize="12.5"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,12"/>

                <ProgressBar x:Name="pbProgress"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="True"
                             Foreground="#0284C7"
                             Background="#E2E8F0"
                             BorderThickness="0"
                             Margin="0,0,0,8"/>

                <TextBlock x:Name="txtStatus"
                           Text="서버 연결 및 최신 버전 메타데이터 조회 중..."
                           FontSize="11"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- State 3: Completed Notification ("프로그램이 최신버전 V~~~로 업데이트 되었습니다") -->
            <StackPanel x:Name="panelCompleted" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="txtCompletedTitle"
                           Text="프로그램이 최신버전으로 업데이트 되었습니다."
                           FontSize="14.5"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           TextWrapping="Wrap"
                           LineHeight="22"/>

                <TextBlock x:Name="txtCompletedDesc"
                           Text="확인 버튼을 누르면 업데이트된 최신 버전으로 프로그램을 시작합니다."
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Action Button Bar -->
        <StackPanel Grid.Row="2"
                    x:Name="panelButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
            <Button x:Name="btnConfirm"
                    Content="확인"
                    Width="100"
                    Style="{StaticResource ModernBtnStyle}"
                    IsDefault="True"
                    Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
