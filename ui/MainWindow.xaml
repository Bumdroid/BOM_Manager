<Window x:Class="BOMManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:BOMManager.UI.Converters"
        xmlns:models="clr-namespace:BOMManager.Models"
        xmlns:controls="clr-namespace:BOMManager.UI.Controls"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Auto"
        Title="BOM Manager V0.0 - SolidWorks 2021"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#E8ECF1"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <converters:ModifiedBackgroundConverter x:Key="ModBg"/>
        <converters:ModifiedForegroundConverter x:Key="ModFg"/>
        <converters:TransparencyEmojiConverter x:Key="TransEmoji"/>
        <converters:TreeTriangleGlyphConverter x:Key="TriangleGlyph"/>
        <converters:LevelToMarginConverter x:Key="LevelToMargin"/>

        <!-- High-Contrast ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <!-- Main Background & Border -->
                <Border Grid.ColumnSpan="2"
                        x:Name="Border"
                        Background="#FFFFFF"
                        BorderBrush="#475569"
                        BorderThickness="1.5"
                        CornerRadius="4"/>
                <!-- Dropdown Button Area -->
                <Border Grid.Column="1"
                        x:Name="ButtonBorder"
                        Background="#F1F5F9"
                        BorderBrush="#94A3B8"
                        BorderThickness="1.5,0,0,0"
                        CornerRadius="0,3,3,0"
                        Margin="0,1.5,1.5,1.5"/>
                <!-- Dropdown Arrow Glyph -->
                <Path Grid.Column="1"
                      x:Name="Arrow"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#1E293B"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B82F6"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#1D4ED8"/>
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#BFDBFE"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#1E40AF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Style with Dead-Center Text Alignment, 100% Clickable Area & High Visibility -->
        <Style x:Key="GridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="False"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderThickness="1.5"
                                            BorderBrush="#2563EB"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="2" Opacity="0.15"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom DataGrid Header Style -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F8FAFC" Offset="0.0"/>
                        <GradientStop Color="#E2E8F0" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
        </Style>

        <!-- Custom DataGrid Row Style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BAE6FD"/>
                    <Setter Property="Foreground" Value="#0C4A6E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom DataGrid Cell Style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BAE6FD"/>
                    <Setter Property="Foreground" Value="#0C4A6E"/>
                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Concept 3 Split Button Style -->
        <Style x:Key="Concept3SplitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Statistics Card -->
            <RowDefinition Height="*"/>    <!-- 2: Table DataGrid -->
            <RowDefinition Height="Auto"/> <!-- 3: Action Buttons -->
            <RowDefinition Height="Auto"/> <!-- 4: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header Panel -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1,1,1,2"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 0: Home Button & App Title -->
                    <ColumnDefinition Width="*"/>    <!-- 1: Document & Connection Status Badge -->
                    <ColumnDefinition Width="Auto"/> <!-- 2: Vault User Status Badge -->
                </Grid.ColumnDefinitions>

                <!-- Left: Home Button + BOM Manager Title with Pepe Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Home / Launcher Navigation Button -->
                    <Button x:Name="btnGoHome"
                            Height="44"
                            Padding="12,0"
                            Background="#EFF6FF"
                            BorderBrush="#93C5FD"
                            BorderThickness="1.5"
                            Cursor="Hand"
                            ToolTip="홈 화면(앱 런처)으로 이동"
                            Click="BtnGoHome_Click"
                            Margin="0,0,12,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="홈 화면" FontSize="13" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="32" Background="#CBD5E1" Margin="0,0,14,0"/>

                    <!-- BOM Manager V0.0 Brand Indicator -->
                    <Border Height="44"
                            Padding="12,4"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="imgLogo" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BOM Manager V0.0" FontSize="15" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="With SolidWorks 2021" FontSize="10" FontWeight="Regular" Foreground="#3B82F6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center/Right: SolidWorks Active Assembly Connection Status Badge -->
                <Border Grid.Column="1"
                        x:Name="borderStatusBadge"
                        CornerRadius="8"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        Padding="14,6"
                        Margin="14,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="dotStatus"
                                 Width="10" Height="10"
                                 Fill="#10B981"
                                 Stroke="#059669"
                                 StrokeThickness="1.5"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatusBadge"
                                   Text="연결 확인 중..."
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#065F46"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Right: User Account Status -->
                <Border Grid.Column="2"
                        Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="7"
                        Height="38"
                        Padding="12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="imgHeaderVaultIcon" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="사용자: " FontSize="14" FontWeight="Regular" Foreground="#15803D" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtHeaderVaultUser" Text="이두규" FontSize="14" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Statistics Card & Sequential Process Steps Toolbar Panel -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <!-- 1) 3-Step Sequential Process Navigator (원문자 ①, ②, ③ 및 Summary) -->
                <Border Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Summary Button (Assy. 정리 좌측에 1cm(38px) 간격으로 배치 - 기본 선택) -->
                        <Button x:Name="btnSummary"
                                Height="36"
                                MinWidth="110"
                                Padding="16,0"
                                Margin="0,0,38,0"
                                Background="#FFFFFF"
                                Foreground="#1D4ED8"
                                BorderBrush="#2563EB"
                                BorderThickness="2.5"
                                Cursor="Hand"
                                Click="BtnSummary_Click"
                                ToolTip="전체 BOM 요약 화면 (부품명, 재질, 수량, Rev, 설명충, 비고)을 확인합니다.">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Summary" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Step 1: ① Assy. 정리 -->
                        <Button x:Name="btnStep1Assy"
                                Height="36"
                                MinWidth="130"
                                Padding="16,0"
                                Background="#FFFFFF"
                                Foreground="#475569"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnStep1Assy_Click"
                                ToolTip="[Step 1] 어셈블리 트리 구조 검토, 서브어셈블리 펼침/접힘 및 화면 표시(Isolate)로 부품과 수량을 정리합니다.">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="① Assy. 정리" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>

                        <!-- High-Visibility Step Arrow 1 -> 2 -->
                        <Border Background="#E2E8F0" CornerRadius="10" Width="22" Height="22" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="➔" Foreground="#1E40AF" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>

                        <!-- Step 2: ② 도번, 재질 입력 -->
                        <Button x:Name="btnStep2DrawingNo"
                                Height="36"
                                MinWidth="140"
                                Padding="16,0"
                                Background="#FFFFFF"
                                Foreground="#475569"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnStep2DrawingNo_Click"
                                ToolTip="[Step 2] 도번, 재질 입력">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="② 도번, 재질 입력" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>

                        <!-- High-Visibility Step Arrow 2 -> 3 -->
                        <Border Background="#E2E8F0" CornerRadius="10" Width="22" Height="22" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="➔" Foreground="#1E40AF" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>

                        <!-- Step 3: ③ 무언가 세팅 -->
                        <Button x:Name="btnStep3Other"
                                Height="36"
                                MinWidth="150"
                                Padding="16,0"
                                Background="#FFFFFF"
                                Foreground="#475569"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="BtnStep3Other_Click"
                                ToolTip="[Step 3] 무언가 세팅 (현재 개발중)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="③ 무언가 세팅" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2) 하단 툴바: 통계 정보 (고유부품, 총수량, 수정됨) & 액션 버튼 (새로고침) -->
                <Grid Margin="2,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Statistics Summary Values -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="고유 부품 수:" FontSize="14" FontWeight="Regular" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblUniqueParts" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,16,0" VerticalAlignment="Center"/>

                        <TextBlock Text="총 수량 (Total Q'TY):" FontSize="14" FontWeight="Regular" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblTotalQty" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="5,0,16,0" VerticalAlignment="Center"/>

                        <TextBlock Text="수정됨 (Modified):" FontSize="14" FontWeight="Regular" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblModifiedCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#D97706" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Quick Action Buttons (새로고침) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnRefresh" Content="🔄 새로고침" Click="BtnRefresh_Click" ToolTip="현재 활성 SolidWorks 어셈블리에서 데이터를 다시 읽어옵니다."/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. BOM View (Horizontal Tree for Step1Assy, DataGrid for Summary/Other) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <!-- 3A. Horizontal Left-to-Right Tree View (Assy 정리 전용 좌→우 수평 트리) -->
            <Border x:Name="borderTreeView"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <controls:HorizontalTreeCanvas x:Name="treeGraphView"/>
            </Border>

            <!-- 3B. BOM DataGrid (Summary, 도번 입력, 기타 모드) -->
            <Border x:Name="borderDataGrid"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4">
                <DataGrid x:Name="dgBom"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#E2E8F0"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          AlternatingRowBackground="#F8FAFC"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          FontSize="14"
                          Foreground="#1E293B"
                          CellEditEnding="DgBom_CellEditEnding">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📁 하위 부품 접기 / 📂 펼치기 (Toggle)" Click="MenuToggleTree_Click"/>
                            <Separator/>
                            <MenuItem Header="📂 전체 트리 펼치기 (Expand All)" Click="BtnExpandAll_Click"/>
                            <MenuItem Header="📁 전체 트리 접기 (Collapse All)" Click="BtnCollapseAll_Click"/>
                            <Separator/>
                            <MenuItem Header="👁️ 선택한 부품만 화면에 표시 (Isolate)" Click="MenuIsolate_Click"/>
                            <Separator/>
                            <MenuItem Header="📐 도면번호 일괄 지정 (Batch Drawing No.)" Click="BtnBatchDrawingNo_Click"/>
                            <MenuItem Header="🏷️ Assy. 종류 일괄 지정 (Batch Assy.)" Click="BtnBatchAssyCategory_Click"/>
                            <MenuItem Header="🏷️ 재질 일괄 지정 (Batch Material)" Click="BtnBatchMaterial_Click"/>
                            <MenuItem Header="📝 비고 일괄 지정 (Batch Remark)" Click="BtnBatchRemark_Click"/>
                            <MenuItem Header="🔄 Rev. 일괄 지정 (Batch Rev)" Click="BtnBatchRev_Click"/>
                            <MenuItem Header="💬 설명충 일괄 지정 (Batch Explanation)" Click="BtnBatchExplanation_Click"/>
                            <Separator/>
                            <MenuItem Header="📋 셀 내용 복사 (Copy)" Click="MenuCopy_Click"/>
                            <MenuItem Header="📂 파트 폴더 열기 (Open Folder)" Click="MenuOpenFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="↩️ 원래 값으로 되돌리기 (Reset)" Click="MenuReset_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Column 0: No. -->
                        <DataGridTemplateColumn x:Name="colItemNo" Header="No." Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsModified, Converter={StaticResource ModBg}}"
                                            Padding="4,2">
                                        <TextBlock Text="{Binding ItemNoDisplay}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="{Binding IsModified, Converter={StaticResource ModFg}, ConverterParameter=Bold}"
                                                   Foreground="{Binding IsModified, Converter={StaticResource ModFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 1: 화면 표시 (Isolate) -->
                        <DataGridTemplateColumn x:Name="colIsolate" Header="화면&#x0a;표시" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Button Width="26" Height="26"
                                            Padding="0" Margin="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="BtnIsolateRow_Click"
                                            ToolTip="클릭 시 SolidWorks에서 이 파트만 불투명(눈 뜸)으로 강조하고 나머지는 투명(눈 감음)화합니다.">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- 불투명 강조 상태: 눈 뜬 눈알 (Black Open Eye) -->
                                            <Canvas Width="16" Height="16" Visibility="{Binding IsOpaque, Converter={StaticResource BoolToVis}}">
                                                <Canvas.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                </Canvas.LayoutTransform>
                                                <Path Stroke="#0F172A" StrokeThickness="1.5" Fill="White"
                                                      Data="M 1.5,8 C 4,3 12,3 14.5,8 C 12,13 4,13 1.5,8 Z"/>
                                                <Ellipse Width="5.5" Height="5.5" Fill="#0F172A"
                                                         Canvas.Left="5.25" Canvas.Top="5.25"/>
                                            </Canvas>

                                            <!-- 투명 상태: 눈 감은 눈알 (Set B: Black Curved Line with Lashes) -->
                                            <Canvas Width="16" Height="16" Visibility="{Binding IsOpaque, Converter={StaticResource BoolToVisInvert}}">
                                                <Canvas.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                </Canvas.LayoutTransform>
                                                <Path Stroke="#0F172A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 2,6.5 C 4.5,11.5 11.5,11.5 14,6.5"/>
                                                <Path Stroke="#0F172A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 3,8 L 1.5,10.5"/>
                                                <Path Stroke="#0F172A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 5.5,9.8 L 4.5,12.8"/>
                                                <Path Stroke="#0F172A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 8,10.5 L 8,13.8"/>
                                                <Path Stroke="#0F172A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 10.5,9.8 L 11.5,12.8"/>
                                                <Path Stroke="#0F172A" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M 13,8 L 14.5,10.5"/>
                                            </Canvas>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 2: Name of Part -->
                        <DataGridTemplateColumn x:Name="colPartName" Header="Name of Part" Width="320">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsPartNameModified, Converter={StaticResource ModBg}}"
                                            Padding="6,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 1. 서브어셈블리 선행 공백 (Level > 0: Level 1=3개, Level 2=6개...) -->
                                            <TextBlock Visibility="{Binding IsSubassembly, Converter={StaticResource BoolToVis}}"
                                                       Text="{Binding SubassemblyIndent}"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontFamily="Consolas, Lucida Console, Courier New"
                                                       xml:space="preserve"/>

                                            <!-- 2. 서브어셈블리 삼각형 토글 버튼 (▼ / ▶) 및 5px 간격 -->
                                            <Button Visibility="{Binding IsSubassembly, Converter={StaticResource BoolToVis}}"
                                                    Content="{Binding IsExpanded, Converter={StaticResource TriangleGlyph}}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="#334155"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,5,0"
                                                    Width="18" Height="18"
                                                    Cursor="Hand"
                                                    Click="BtnTreeToggle_Click"
                                                    ToolTip="하위 부품 펼치기/접기"/>

                                            <!-- 3. 일반 파트 선행 접두사 (Level >= 1일 때 Level * 3개 공백 + └  ) -->
                                            <TextBlock Visibility="{Binding IsSubassembly, Converter={StaticResource BoolToVisInvert}}"
                                                       Text="{Binding PartPrefix}"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       Foreground="#64748B"
                                                       FontFamily="Consolas, Lucida Console, Courier New"
                                                       xml:space="preserve"/>

                                            <!-- 4. 순수 파트명 -->
                                            <TextBlock Text="{Binding PartName}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       FontWeight="{Binding IsSubassembly, Converter={StaticResource ModFg}, ConverterParameter=SubassemblyBold}"
                                                       Foreground="{Binding IsPartNameModified, Converter={StaticResource ModFg}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding PartName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             Padding="4,2"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 3: Q'TY (공통) -->
                        <DataGridTemplateColumn x:Name="colQty" Header="Q'TY" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsQtyModified, Converter={StaticResource ModBg}}"
                                            Padding="4,2">
                                        <TextBlock Text="{Binding Qty}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsQtyModified, Converter={StaticResource ModFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 4: Material (재질 - 텍스트 표시) -->
                        <DataGridTemplateColumn x:Name="colMaterial" Header="Material" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsMaterialModified, Converter={StaticResource ModBg}}"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Material}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsMaterialModified, Converter={StaticResource ModFg}}"
                                                   FontWeight="Regular"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 5: Drawing No. (도면번호 입력 모드: OOO-PPPPPGBBBXXXX 컬러 서식) -->
                        <DataGridTemplateColumn x:Name="colDrawingNo" Header="Drawing No." Width="230" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsDrawingNoModified, Converter={StaticResource ModBg}}"
                                            Padding="6,2">
                                        <TextBlock FontFamily="Consolas, Lucida Console, Segoe UI, Malgun Gothic"
                                                   FontSize="14"
                                                   VerticalAlignment="Center">
                                            <!-- O: 빨간색 (Red) -->
                                            <Run Text="{Binding DrawingNoPartO, Mode=OneWay}" Foreground="#DC2626" FontWeight="Bold"/>
                                            <!-- - : 구분 하이픈 -->
                                            <Run Text="{Binding DrawingNoHyphen, Mode=OneWay}" Foreground="#64748B" FontWeight="Bold"/>
                                            <!-- P: 진노랑 (Dark Yellow / Amber) -->
                                            <Run Text="{Binding DrawingNoPartP, Mode=OneWay}" Foreground="#D97706" FontWeight="Bold"/>
                                            <!-- G: 초록색 (Green) -->
                                            <Run Text="{Binding DrawingNoPartG, Mode=OneWay}" Foreground="#16A34A" FontWeight="Bold"/>
                                            <!-- B: 파란색 (Blue) -->
                                            <Run Text="{Binding DrawingNoPartB, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold"/>
                                            <!-- X: 보라색 (Purple) -->
                                            <Run Text="{Binding DrawingNoPartX, Mode=OneWay}" Foreground="#9333EA" FontWeight="Bold"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding DrawingNo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="Consolas, Lucida Console, Segoe UI, Malgun Gothic"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             FontWeight="Regular"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 6: Rev. (공통) -->
                        <DataGridTemplateColumn x:Name="colRev" Header="Rev." Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsRevModified, Converter={StaticResource ModBg}}"
                                            Padding="4,2">
                                        <TextBlock Text="{Binding Rev}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsRevModified, Converter={StaticResource ModFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding Rev, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 7: 설명충 (Rev. 바로 옆 칸) -->
                        <DataGridTemplateColumn x:Name="colExplainer" Header="설명충" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsExplanationModified, Converter={StaticResource ModBg}}"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Explanation}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsExplanationModified, Converter={StaticResource ModFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding Explanation, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 8: REMARK (Summary 모드) -->
                        <DataGridTemplateColumn x:Name="colRemark" Header="REMARK" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <Border Background="{Binding IsRemarkModified, Converter={StaticResource ModBg}}"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding Remark}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding IsRemarkModified, Converter={StaticResource ModFg}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="{x:Type models:BOMItem}">
                                    <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             VerticalContentAlignment="Center"
                                             FontSize="14"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 4. Bottom Action Panel (Export & Reports) -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnExportExcel"
                        Content="📊 Excel 내보내기"
                        Style="{StaticResource SuccessButtonStyle}"
                        Margin="0,0,6,0"
                        Click="BtnExportExcel_Click"/>

                <Button x:Name="btnExportCsv"
                        Content="📄 CSV 내보내기"
                        Click="BtnExportCsv_Click"/>
            </StackPanel>
        </Grid>

        <!-- 5. Status Bar -->
        <Border Grid.Row="4"
                Background="#DFE4EA"
                BorderBrush="#CBD5E1"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                Margin="-16,0,-16,-16">
            <TextBlock x:Name="txtStatusBar"
                       Text="BOM Manager 준비 완료."
                       FontSize="12"
                       Foreground="#334155"/>
        </Border>

        <!-- 6. Full-Screen Modal Loading & SolidWorks Lock Overlay -->
        <Grid x:Name="gridLoadingOverlay"
              Grid.Row="0"
              Grid.RowSpan="5"
              Background="#990F172A"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              Margin="-16,-16,-16,-16">
            <Border Background="#FFFFFF"
                    BorderBrush="#3B82F6"
                    BorderThickness="2"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Color="#0F172A" Opacity="0.35" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Top Lock / Processing Badge -->
                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔒 SolidWorks 조작 방지 잠금 활성화됨"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <!-- Title -->
                    <TextBlock x:Name="txtLoadingTitle"
                               Text="사본 저장 및 서브어셈블리 구성 중..."
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextAlignment="Center"
                               Margin="0,0,0,18"/>

                    <!-- Modern Indeterminate Progress Bar -->
                    <ProgressBar IsIndeterminate="True"
                                 Height="8"
                                 Foreground="#2563EB"
                                 Background="#E2E8F0"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
