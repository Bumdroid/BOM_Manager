<Window x:Class="BOMManager.Modules.SpringDesigner.Views.SpringFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="버그신고 및 기능제안 (VoC)" 
        Height="500" Width="470" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="pack://application:,,,/resources/Fonts/#Pretendard, ./resources/Fonts/#Pretendard, Pretendard, Malgun Gothic, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐞 버그신고 / 💡 기능제안 접수" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel Orientation="Vertical">
                <!-- 작성자 -->
                <TextBlock Text="👤 작성자 (User Name)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtAuthor" FontSize="12.5" Padding="8,6" Margin="0,0,0,16" Background="#FFFFFF" BorderBrush="#CBD5E1"/>

                <!-- 유형 선택 -->
                <TextBlock Text="📌 유형 선택" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="RbBug" Content="🐞 버그신고 (Bug Report)" IsChecked="True" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbProposal" Content="💡 기능제안 (Feature Suggestion)" FontSize="12" FontWeight="SemiBold" Foreground="#0D9488" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 내용 -->
                <TextBlock Text="📝 상세 내용" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtContent" FontSize="12.5" Padding="8,8" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✉️ 보내기" Click="BtnSend_Click" Width="120" Height="36" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
